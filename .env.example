# 项目根目录环境变量模板
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交到仓库）

# 高德地图 Web 服务 Key（必填）
# 申请地址：https://console.amap.com/dev/key/app
# 类型选择「Web服务」，不要选「Web端(JS API)」
WENLV_AMAP_KEY=your_amap_web_service_key_here

# LLM（OpenAI 兼容接口，如阿里云百炼 / OpenAI 官方 / DeepSeek 等）
# 模式：mock=假数据（演示），real=真实大模型
WENLV_LLM_MODE=real
WENLV_LLM_API_KEY=your_llm_api_key_here
WENLV_LLM_BASE_URL=https://your-endpoint.compatible-mode/v1
WENLV_LLM_MODEL=qwen3.7-plus

# JWT 密钥（生产必须改成随机字符串）
WENLV_JWT_SECRET=change-me-to-a-random-secret
