# 复制为 .env 并按需修改（配置前缀 WENLV_，见 app/core/config.py）

# 数据库 / Redis
WENLV_DATABASE_URL=postgresql+asyncpg://wenlv:wenlv@localhost:5432/wenlv
WENLV_REDIS_URL=redis://localhost:6379/0
WENLV_REDIS_PREFIX=wenlv

# JWT
WENLV_JWT_SECRET=dev-only-insecure-secret-change-me

# 工作区
WENLV_WORKSPACE_ROOT=./workspace

# HITL 阈值
WENLV_BUDGET_OVER_RATIO=0.20
WENLV_REVIEW_TIMEOUT_HOURS=24
WENLV_SENTIMENT_MIN_SCORE=0.25

# LLM
WENLV_LLM_MODE=mock

# 高德地图（真实数据源）—— 填入你自己的 Web 服务 Key，勿提交真实 key 到仓库
WENLV_AMAP_KEY=your_amap_web_service_key_here
WENLV_AMAP_ENABLED=true

# 队列/恢复
WENLV_REQUEST_STREAM=stream:plan.requests
WENLV_RESUME_STREAM=stream:plan.resume
WENLV_CONSUMER_GROUP=cg:wenlv-workers
